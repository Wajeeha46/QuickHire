<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <!--  Header Section  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#5C2D87" android:padding="24dp">
            <ImageView android:id="@+id/detailWorkerImage" android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="center" android:layout_marginBottom="16dp" android:contentDescription="Worker image" android:scaleType="centerCrop" android:src="@drawable/worker_placeholder"/>
            <TextView android:id="@+id/detailNameText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold"/>
            <TextView android:id="@+id/detailCategoryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:textColor="@color/white" android:textSize="16sp"/>
        </LinearLayout>
        <!--  Contact Information Section  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contact Information" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
            <!--  Email  -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_email" android:layout_marginEnd="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Email" android:textSize="14sp" android:textColor="@android:color/darker_gray"/>
                    <TextView android:id="@+id/detailEmailText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp"/>
                </LinearLayout>
            </LinearLayout>
            <!--  Phone  -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_phone" android:layout_marginEnd="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Phone" android:textSize="14sp" android:textColor="@android:color/darker_gray"/>
                    <TextView android:id="@+id/detailPhoneText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp"/>
                </LinearLayout>
            </LinearLayout>
            <!--  Experience  -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_experience" android:layout_marginEnd="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Experience" android:textSize="14sp" android:textColor="@android:color/darker_gray"/>
                    <TextView android:id="@+id/detailExperienceText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp"/>
                </LinearLayout>
            </LinearLayout>
            <!--  Bio  -->
            <TextView android:id="@+id/detailBioText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="14sp"/>
        </LinearLayout>
        <!--  Hire Button  -->
        <Button android:id="@+id/detailHireButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" android:text="Hire Now" android:backgroundTint="#5C2D87" android:textColor="@color/white"/>
    </LinearLayout>
</ScrollView>