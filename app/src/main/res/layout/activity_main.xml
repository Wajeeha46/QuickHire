<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- Spacer for top (helps in landscape) -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Logo Image (centered) -->
    <ImageView
        android:id="@+id/splashImage"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/image1"
        android:contentDescription="@drawable/image1"
        android:layout_gravity="center_horizontal" />

    <!-- Spacer between image and button -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="24dp" />

    <!-- Get Started Button -->
    <Button
        android:id="@+id/btnGetStarted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Get Started with QuickHire"
        android:textSize="18sp"
        android:backgroundTint="#5C2D87"
        android:textColor="@color/white"
        android:minWidth="200dp"
        android:paddingVertical="12dp"
        android:paddingHorizontal="24dp"
        android:layout_gravity="center_horizontal" />

    <!-- Spacer for bottom (helps in landscape) -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>